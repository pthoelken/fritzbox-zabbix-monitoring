# =============================================================================
# FritzBox Zabbix Monitoring - Environment Configuration
# =============================================================================
# Copy to .env and adjust. Do NOT commit .env to version control.
# =============================================================================

# --- Image Version ---
VERSION=latest

# --- Zabbix Server ---
ZABBIX_SERVER=192.168.178.100
ZABBIX_SERVER_PORT=10051
TLS_PSK_IDENTITY=
TLS_PSK_FILE=/run/secrets/zabbix_psk

# --- FritzBox ---
FRITZBOX_IP=192.168.178.1
FRITZBOX_PORT=49000
FRITZBOX_USE_TLS=false
FRITZBOX_USER=zabbixmonitor
FRITZBOX_PASSWD=changeme

# Must match the Zabbix host name exactly
FRITZBOX_HOSTNAME=fritz.box

# --- Monitoring ---
# Supports s (seconds), m (minutes), h (hours)
INTERVAL=60s
ZABBIX_SENDER_DEBUG=false

# --- Feature Toggles ---
# LUA interface: CPU temp, RAM, traffic statistics, per-device RSSI
ENABLE_LUA=true

# Callmonitor: Phone call tracking (activate first: dial #96*5* on DECT phone)
ENABLE_CALLMONITOR=false
CALLMONITOR_PORT=1012

# Device log streaming
# Keep this key aligned with the template item key (value type: LOG)
DEVICE_LOG_ITEM_KEY=fritzbox.device.log

# Number of remembered device log events for de-duplication
DEVICE_LOG_HISTORY_SIZE=5000
